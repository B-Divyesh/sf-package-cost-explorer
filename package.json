{
  "name": "package-cost-explorer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run && npm run test:badge-worker",
    "test:export-scale": "vitest run src/export-scale.test.ts",
    "test:badge": "vitest run src/badge.test.ts",
    "test:badge-worker": "node --test api/badge/contract.cjs",
    "test:pwa-update": "node scripts/pwa-update-check.mjs",
    "test:live": "node scripts/live-check.mjs",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:claims": "playwright test e2e/claims.e2e.ts --project=desktop",
    "test:accessibility": "playwright test e2e/product.e2e.ts --grep accessible",
    "test:privacy": "playwright test e2e/claims.e2e.ts --project=desktop --grep \"@claim:(demo-isolation|no-account-analytics|npm-direct)\"",
    "test:offline": "playwright test e2e/claims.e2e.ts --project=desktop --grep @claim:offline-reload",
    "assets": "node scripts/optimize-assets.mjs"
  },
  "dependencies": {
    "brotli-wasm": "^3.0.1",
    "esbuild-wasm": "^0.25.9",
    "fflate": "^0.8.2",
    "semver": "^7.7.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "1.58.2",
    "@types/node": "^24.3.0",
    "@types/semver": "^7.7.0",
    "jsdom": "^26.1.0",
    "sharp": "^0.35.4",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
